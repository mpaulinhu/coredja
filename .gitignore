# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dados do Coredja: banco SQLite e imagens enviadas pelas áreas.
# Nunca entram no git — são os recados reais da igreja, e o backup deles é
# copiar esta pasta (ver README).
/dados/

# Chave de administrador do Firebase e qualquer outro segredo.
# Quem tem esse arquivo lê, escreve e apaga tudo no projeto, ignorando as
# regras de segurança. Nunca pode ir para o git.
/segredos/
*firebase-adminsdk*.json
serviceAccountKey.json
