rules_version = '2';

// Regras de segurança do Firestore do Coredja.
//
// LEITURA liberada, ESCRITA bloqueada.
//
// A leitura precisa estar aberta porque é o navegador que escuta o Firestore
// para receber os recados em tempo real — é isso que faz um recado aparecer no
// painel sem ninguém atualizar a página.
//
// A escrita fica fechada para todos. Todo envio passa pelo servidor, que usa a
// credencial de administrador e ignora estas regras. Assim ninguém cria,
// altera ou apaga recado direto no banco, mesmo conhecendo o endereço do
// projeto.
//
// O que a leitura aberta expõe: o texto dos recados e o nome das áreas. Numa
// comunicação interna de igreja isso é aceitável — são avisos operacionais,
// não dado pessoal sensível.
//
// O que ela NÃO expõe: o `token` de cada área, que é o segredo do link de
// envio. Ele nunca é gravado no Firestore (ver firebase-store.ts) e é
// conferido no servidor, contra areas.ts.
//
// Para publicar estas regras:
//   Console do Firebase → Firestore → aba "Regras" → colar e Publicar
service cloud.firestore {
  match /databases/{database}/documents {

    // Recados. O navegador lê para exibir e para receber os avisos em tempo
    // real; escrever só pelo servidor.
    match /mensagens/{mensagem} {
      allow read: if true;
      allow write: if false;
    }

    // Departamentos (nome e cor). Fonte da verdade real desde a
    // generalização "qualquer departamento fala com qualquer outro" — ver
    // src/lib/firebase-store.ts.
    match /departamentos/{departamento} {
      allow read: if true;
      allow write: if false;
    }

    // Papéis e áreas visíveis de cada pessoa da igreja que faz login no
    // Coredja publicado — ver `src/lib/papeis.ts`, `sessao.ts` e
    // `pessoas-store.ts`. Fechada para o navegador dos dois lados: o
    // servidor lê com o Admin SDK (que ignora estas regras) para conferir
    // permissão a cada requisição, e é o único que escreve, quando um admin
    // convida ou edita alguém em `src/app/api/pessoas/`. Uma pessoa nunca
    // precisa consultar o Firestore diretamente para saber seu próprio
    // papel — a tela pergunta ao servidor, que já confere o token.
    match /pessoas/{uid} {
      allow read, write: if false;
    }

    // Ordem do Culto (um documento por data, id "AAAA-MM-DD") — ver
    // `src/lib/culto.ts`.
    // Mesma lógica de `mensagens`: leitura aberta porque é o navegador do
    // operador que escuta o Firestore direto para a tela avançar sozinha no
    // domingo, sem F5. Escrita só pelo servidor, que confere o papel de quem
    // pediu (líder monta, operador avança) antes de gravar — ver
    // `src/app/api/culto/route.ts`.
    //
    // A sequência do culto não é dado sensível — é a mesma informação que
    // hoje já fica visível num papel colado na mesa de som.
    match /culto/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // Avisos do Telão — ver `src/lib/avisos.ts`. Mesma lógica de `culto`:
    // leitura aberta para o navegador escutar em tempo real qual aviso está
    // no ar; escrita só pelo servidor, que confere `avisos:escrever` (líder,
    // para cadastrar/remover) ou `avisos:publicar` (operador, para o telão)
    // antes de gravar — ver `src/app/api/avisos/`.
    match /avisos/{aviso} {
      allow read: if true;
      allow write: if false;
    }

    // Escala do Time (documento único, id "atual") — ver `src/lib/escala.ts`.
    // Mesma lógica de `culto`: leitura aberta para a tela mostrar quem
    // confirmou presença em tempo real; escrita só pelo servidor, que
    // confere `escala:escrever` (coordenador, para montar) ou
    // `escala:presenca` (operador, para confirmar) — ver
    // `src/app/api/escala/`. Nomes de voluntários do time técnico não são
    // dado sensível no mesmo sentido de currículo ou documento — é a mesma
    // informação que hoje já circula num grupo de WhatsApp da equipe.
    match /escala/{documento} {
      allow read: if true;
      allow write: if false;
    }

    // Mensagens prontas para colar no chat da transmissão ao vivo — ver
    // `src/lib/live.ts`. Mesma lógica de `avisos`: leitura aberta porque é o
    // navegador de quem opera a live que escuta o Firestore direto, para a
    // biblioteca aparecer atualizada sem F5 no meio da transmissão; escrita
    // só pelo servidor, que confere `live:escrever` (coordenador) antes de
    // gravar — ver `src/app/api/live/`.
    //
    // Texto de boas-vindas e de oferta não é dado sensível: é exatamente o
    // que já vai aparecer público no chat do YouTube segundos depois.
    match /mensagens_live/{mensagem} {
      allow read: if true;
      allow write: if false;
    }

    // Configurações da instalação (endereço e TOKEN do Holyrics) — ver
    // `src/lib/configuracoes.ts`.
    //
    // FECHADA DOS DOIS LADOS, e este é o único lugar do Coredja onde a
    // negação de LEITURA importa de fato. Todas as coleções acima têm leitura
    // aberta porque o navegador precisa escutá-las em tempo real e o conteúdo
    // não é sensível. Aqui é o oposto: o documento guarda o token do Holyrics,
    // e leitura aberta o entregaria a qualquer pessoa que soubesse o id do
    // projeto — sem precisar de login nenhum.
    //
    // Nenhuma tela lê esta coleção direto: a de Configurações pergunta ao
    // servidor, que confere o papel de admin e devolve o token MASCARADO
    // (ver `mascarar`). O valor real nunca sai do servidor.
    //
    // O catch-all abaixo já negaria os dois por omissão. O bloco existe
    // explícito porque "esta coleção é fechada de propósito, e por quê" é
    // diferente de "esta coleção ainda não foi pensada" — e a diferença
    // importa no dia em que alguém for abrir uma exceção aqui.
    match /configuracoes/{documento} {
      allow read, write: if false;
    }

    // Fila de comandos para o telão e sinal de vida da ponte — ver
    // `src/lib/telao-fila.ts`.
    //
    // FECHADAS DOS DOIS LADOS, como `configuracoes` e diferente de
    // `mensagens`/`avisos`/`culto`. Aqui não há motivo para o navegador
    // participar: quem escreve é o servidor do Coredja (Admin SDK, que ignora
    // estas regras) e quem lê é a ponte, que roda no PC do audiovisual com
    // credencial própria de administrador — nunca uma página aberta.
    //
    // Deixar a leitura aberta "porque não é dado sensível" seria um erro
    // diferente do óbvio: a fila não carrega segredo, mas carrega o que vai
    // ao telão da igreja em tempo real, e escrita aberta deixaria qualquer
    // pessoa projetar o que quisesse durante o culto.
    match /telao_comandos/{comando} {
      allow read, write: if false;
    }

    match /telao_estado/{documento} {
      allow read, write: if false;
    }

    // Qualquer outra coleção fica fechada por padrão. Sem este bloco, uma
    // coleção nova criada no futuro herdaria o comportamento errado.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
